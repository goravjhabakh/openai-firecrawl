{
  "name": "@goravjhabakh/openai-firecrawl",
  "version": "1.1.0",
  "description": "Local Windows-first orchestrator connecting ChatGPT to self-hosted Firecrawl via the official Firecrawl MCP server and OpenAI Secure MCP Tunnel.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "openai-firecrawl": "./dist/cli.js"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/goravjhabakh/openai-firecrawl.git"
  },
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "init": "tsx src/cli.ts init",
    "start": "tsx src/cli.ts start",
    "doctor": "tsx src/cli.ts doctor",
    "stop": "tsx src/cli.ts stop",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  },
  "dependencies": {
    "firecrawl-mcp": "3.30.3"
  }
}
